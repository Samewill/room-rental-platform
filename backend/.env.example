DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated browser origins allowed to call the API.
# Add the deployed frontend origin when frontend and backend use different origins.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI assistant providers. Keep API keys on the backend only.
INCEPTION_API_KEY=
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_MODEL=mercury-3
INCEPTION_MAX_TOKENS=1024
INCEPTION_MAX_RETRIES=2
INCEPTION_BACKOFF_BASE_SECONDS=1
INCEPTION_BACKOFF_MAX_SECONDS=8

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024

LLM_CALL_TIMEOUT_SECONDS=20

# Server-side key restricted to Places API (New); never expose it to the frontend.
GOOGLE_MAPS_SERVER_API_KEY=
