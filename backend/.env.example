DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated browser origins allowed to call the API.
# Add the deployed frontend origin when frontend and backend use different origins.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Meta WhatsApp Business Cloud API (keep credentials and keys out of source control).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Generate each key independently; encryption key must be URL-safe base64 for 32 random bytes.
WHATSAPP_PHONE_ENCRYPTION_KEY=
WHATSAPP_PHONE_LOOKUP_KEY=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_VERIFICATION_TEMPLATE_NAME=rental_phone_verification
WHATSAPP_MESSAGE_TEMPLATE_NAME=rental_message_notification
