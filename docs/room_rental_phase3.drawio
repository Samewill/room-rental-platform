<mxfile host="app.diagrams.net">
  <diagram id="room-rental-phase3" name="Room Rental Platform ERD">
    <mxGraphModel dx="1400" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="users" value="&lt;b&gt;USERS&lt;/b&gt;&lt;br&gt;PK user_id : BIGINT IDENTITY&lt;br&gt;full_name : VARCHAR(150)&lt;br&gt;phone_no : VARCHAR(20) UNIQUE&lt;br&gt;email : VARCHAR(255) UNIQUE NULL&lt;br&gt;password_hash : VARCHAR(255) NULL&lt;br&gt;role : VARCHAR(8)&lt;br&gt;business_name : VARCHAR(150) NULL&lt;br&gt;created_at : TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fillColor=#d5e8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="410" y="40" width="300" height="230" as="geometry" />
        </mxCell>
        <mxCell id="areas" value="&lt;b&gt;AREAS&lt;/b&gt;&lt;br&gt;PK area_id : BIGINT IDENTITY&lt;br&gt;name : VARCHAR(150) UNIQUE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="listings" value="&lt;b&gt;LISTINGS&lt;/b&gt;&lt;br&gt;PK listing_id : BIGINT IDENTITY&lt;br&gt;FK landlord_id : BIGINT -&gt; users.user_id&lt;br&gt;FK area_id : BIGINT -&gt; areas.area_id&lt;br&gt;title : VARCHAR(150)&lt;br&gt;description : TEXT&lt;br&gt;room_type : VARCHAR(14)&lt;br&gt;monthly_rent : NUMERIC(10,2)&lt;br&gt;deposit_amount : NUMERIC(10,2)&lt;br&gt;address : VARCHAR(255)&lt;br&gt;date_available : DATE&lt;br&gt;status : VARCHAR(7)&lt;br&gt;created_at : TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="300" height="300" as="geometry" />
        </mxCell>
        <mxCell id="listing_photos" value="&lt;b&gt;LISTING_PHOTOS&lt;/b&gt;&lt;br&gt;PK photo_id : BIGINT IDENTITY&lt;br&gt;FK listing_id : BIGINT -&gt; listings.listing_id&lt;br&gt;url : VARCHAR(500)&lt;br&gt;uploaded_at : TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="930" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="listing_moderation" value="&lt;b&gt;LISTING_MODERATION&lt;/b&gt;&lt;br&gt;PK moderation_id : BIGINT IDENTITY&lt;br&gt;FK listing_id : BIGINT -&gt; listings.listing_id&lt;br&gt;FK admin_id : BIGINT -&gt; users.user_id&lt;br&gt;decision : VARCHAR(8)&lt;br&gt;reason : TEXT NULL&lt;br&gt;decided_at : TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="1150" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="amenities" value="&lt;b&gt;AMENITIES&lt;/b&gt;&lt;br&gt;PK amenity_id : BIGINT IDENTITY&lt;br&gt;name : VARCHAR(100) UNIQUE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
