# Leave empty for local development to use the Vite /api proxy.
# Set to the API origin when the frontend and backend are deployed separately.
VITE_API_BASE_URL=

# Public browser key: restrict by HTTP referrer and enabled APIs in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=
# Create a Google Maps map ID for production; development can use DEMO_MAP_ID.
VITE_GOOGLE_MAP_ID=